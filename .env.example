# ============================================================
# 네이버 블로그 업로더 환경 변수
# ------------------------------------------------------------
# 이 파일을 복사해서 .env 로 저장한 뒤 실제 값으로 바꿔주세요.
#   cp .env.example .env
# .env 는 git에 커밋되지 않습니다.
# ============================================================

# [필수] 네이버 계정
NAVER_USERNAME=your_naver_id
NAVER_PASSWORD=your_naver_password

# [선택] 추가 계정 (멀티 계정 사용 시, 최대 9번까지)
# NAVER_USERNAME_2=
# NAVER_PASSWORD_2=
# NAVER_USERNAME_3=
# NAVER_PASSWORD_3=

# [선택] 브라우저 옵션
# BROWSER_HEADLESS=false       # true면 화면 없이 실행
# BROWSER_TIMEOUT=30000
# VIEWPORT_WIDTH=1920
# VIEWPORT_HEIGHT=1080

# [선택] 블로그 업로드 옵션
# POSTS_PER_ACCOUNT=7          # 계정당 1회 실행 시 최대 글 수
# UPLOAD_DELAY=2000            # 업로드 간 대기 시간(ms)
# IMAGE_UPLOAD_TIMEOUT=10000

# [선택] 로그
# LOG_DIR=./logs
# LOG_LEVEL=info
